{
  "_说明": "情人节季节规则包。换季节 = 复制这个文件改 roots / products，代码不用动。",
  "_顺序铁律": "① subclass_guards 先过 ② ambiguity 再剔 ③ products 按顺序首个命中生效 —— 所以越具体的产品要排得越靠前。",

  "name": "valentine",
  "label": "情人节 Valentine",

  "roots": ["valentine", "galentine"],

  "_roots说明": "'valentine' 带复数后缀规则 → 自动覆盖 valentines / valentine's day。'galentine'（闺蜜节）是这几年真实起量的新场景，单独收一个词根。两个都 >= 6 字符 → 只查左边界；注意 'valentino'（品牌）不含 'valentine'，天然不会误命中。'vday' 只有 4 字符（短词根要两边都查，误命中风险高）所以刻意不收。",

  "_subclass_guards说明": "含 valentine 但不是商品的一类词，先整条摘出去（≈ 圣诞包里的 tree skirt）",
  "subclass_guards": [
    "movie", "movies", "blu ray", "dvd", "soundtrack",
    "my bloody valentine", "valentine one", "valentine 1",
    "valentine massacre", "valentine vodka"
  ],

  "_ambiguity说明": "同形异义：词里带着情人节关键词，但主体其实是另一个品类（电子 / 健康 / 音乐）。⚠️ ambiguity 是「一票否决」——只要命中就整条丢。所以这里**只放几乎不可能出现在正当商品词里的冲突**。反例说明：'rose gold' 看着像冲突，**不能放这里** —— 放了会把 `valentine rose gold necklace`（正当爆款礼物）整条丢掉。正确的解法是**把「珠宝首饰」排在「鲜花玫瑰」前面**，让 necklace 先命中。",
  "ambiguity": [
    "cupid shuffle",
    "heart rate",
    "heart monitor",
    "heartburn",
    "heart supplement"
  ],

  "_products说明": "match 里的关键词用「包含」匹配（与词根边界不同，产品名不做边界，因为要考虑 rose/roses 等形态）。subclasses 用于子类下钻。",
  "products": [
    {
      "name": "珠宝首饰",
      "_note": "🔴 必须排在「鲜花玫瑰」之前：`valentine rose gold necklace` 里既有 rose 又有 necklace。珠宝排前面 → 归珠宝（对）；鲜花排前面 → 归鲜花（错，且这一条是情人节最大的礼物盘之一）。",
      "match": ["necklace", "earring", "earrings", "bracelet", "ring", "pendant", "jewelry", "anklet", "brooch", "charm", "locket", "cufflink"],
      "subclasses": ["gold", "rose gold", "silver", "sterling", "heart", "personalized", "initial", "birthstone", "matching", "couple", "for her", "for him"]
    },
    {
      "name": "服装装扮",
      "match": ["dress", "outfit", "shirt", "t shirt", "tshirt", "tee shirt", "sweater", "sweatshirt", "hoodie", "pajama", "onesie", "socks", "leggings", "tights", "bow tie", "tie", "suit", "vest"],
      "subclasses": ["women", "men", "kids", "toddler", "baby", "girls", "boys", "couple", "matching", "plus size", "mom", "dad"]
