      "subclasses": ["red", "pink", "preserved", "eternal", "real", "artificial", "hd", "dozen", "forever", "single"]
    },
    { "name": "巧克力糖果", "match": ["chocolate", "chocolates", "candy", "truffle", "lollipop", "gummy", "gummies", "caramel", "conversation heart", "candy heart", "marshmallow"], "subclasses": [] },
