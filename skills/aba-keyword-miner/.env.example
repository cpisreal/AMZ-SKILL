# 复制成 .env 并填上你的 key（只填一个就行）

# 方案 A：OpenRouter（不用注册 TypeSafe，有 OpenRouter 账号即可）
#   申请：https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 方案 B：TypeSafe 直连
#   申请：https://docs.typesafe.ai
TYPESAFE_API_KEY=ts-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 抓 Amazon Listing 如果被验证码拦，填个干净出口的代理
# HTTP_PROXY=http://127.0.0.1:7890
